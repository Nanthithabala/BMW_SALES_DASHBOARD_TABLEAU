      <column caption='SALES' datatype='integer' name='[Calculation_0522826916388864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([OrderDate])=2024 THEN [Revenue] END)' />
      </column>
      <column caption='TARGET' datatype='real' name='[Calculation_0634977001590788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue])*0.5' />
